---
layout: null
permalink: /feed.xml
---
{%- comment -%}
  手写 Atom feed，替代 jekyll-feed。

  为什么不用插件：jekyll-feed 不按语言过滤。此前 feed.xml 被排除在本地化之外，
  三语共用一份，里面 en 和 zh 混装——中文订阅者收到英文文章，日文一条都没有。

  本文件参与本地化，每种语言各生成一份：/feed.xml · /zh/feed.xml · /ja/feed.xml
  每份只含该语言的文章，链接一律用规范 URL（与 canonical 一致）。
{%- endcomment -%}
{%- assign lang = site.active_lang | default: site.default_lang -%}
{%- if lang == site.default_lang -%}{%- assign prefix = "" -%}{%- else -%}{%- assign prefix = "/" | append: lang -%}{%- endif -%}
{%- assign t = site.data.i18n[lang] -%}
{%- assign feed_title = t.site_title | default: site.title -%}
{%- assign feed_subtitle = t.site_description | default: site.description -%}
{%- assign lang_tag = lang | replace: "zh", "zh-CN" | replace: "ja", "ja-JP" | replace: "en", "en-US" -%}
{%- assign posts = site.posts | where: "lang", lang -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ lang_tag }}">
  <generator uri="https://jekyllrb.com/">Jekyll</generator>
  <link href="{{ site.url }}{{ prefix }}/feed.xml" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}{{ prefix }}/" rel="alternate" type="text/html" hreflang="{{ lang }}" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ prefix }}/feed.xml</id>
  <title type="html">{{ feed_title | escape }}</title>
  <subtitle>{{ feed_subtitle | escape }}</subtitle>
  <author><name>kanfu-panda</name></author>
{%- for post in posts limit: 20 %}
  <entry xml:lang="{{ lang_tag }}">
    <title type="html">{{ post.title | escape }}</title>
    <link href="{{ site.url }}{{ prefix }}{{ post.url }}" rel="alternate" type="text/html" title="{{ post.title | escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ prefix }}{{ post.url }}</id>
    <author><name>kanfu-panda</name></author>
    {%- if post.image %}
    <media:thumbnail xmlns:media="http://search.yahoo.com/mrss/" url="{{ post.image | absolute_url }}" />
    {%- endif %}
    <summary type="html">{{ post.excerpt | strip_html | strip_newlines | escape }}</summary>
    {%- for tag in post.tags %}
    <category term="{{ tag | escape }}" />
    {%- endfor %}
    <content type="html" xml:base="{{ site.url }}{{ prefix }}{{ post.url }}"><![CDATA[{{ post.content }}]]></content>
  </entry>
{%- endfor %}
</feed>
